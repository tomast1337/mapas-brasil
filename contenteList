cities_df = pd.read_csv("cities.csv", delimiter=";", encoding="utf-8")

# for each city, get the list generate a new column with the picture file name
# like name_state.png


def get_city_image(city):
    city_name = city["municipio"]
    state = city["uf"]
    city_name = unidecode(city_name)
    state = unidecode(state)
    city_name = city_name.replace(" ", "_")
    state = state.replace(" ", "_")
    city_name = city_name.lower()
    state = state.lower()
    file_name = f"{city_name}_{state}.png"
    city["file_name"] = file_name
    return city


cities_df = cities_df.apply(get_city_image, axis=1)

